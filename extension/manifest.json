{
  "manifest_version": 3,
  "name": "AI Video Tutor",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Learn with grounded AI tutoring for supported educational videos.",
  "permissions": [
    "activeTab",
    "identity",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage",
    "tabCapture"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "https://*.amazoncognito.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open AI Video Tutor"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "css": ["content.css"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": []
}
